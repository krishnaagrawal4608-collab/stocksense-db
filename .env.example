# StockSense DB — Supabase PostgreSQL Environment Configuration
# Replace these with your actual Supabase Project details from https://supabase.com/dashboard

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Public Key (found in Project Settings > API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
